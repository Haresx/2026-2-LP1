
#include<stdio.h>

int main (){
int health = 100;
int damage = 10;

for (int i =1; i<=100;i++){
	if(i%15==0){
		printf("FIZZBUZZ\n");
	}else{
		if(i%3==0){
			printf("FIZZ\n");
		}else if(i%5==0){
			printf("BUZZ\n");
		}else{
			printf("%d\n",i);
		}
	}
}
printf("Hola mundo\n");
printf("Este es uno de mis intentos de compilacion en linux desde consola :D\n");
printf("mi vida es %d\n", health);
printf("mi daño es %d\n", damage);
return 0;

}
